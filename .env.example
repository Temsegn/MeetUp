# ── Docker Compose environment overrides ──────────────────────────────────────
# Copy this file to .env and fill in real values before running docker compose.

# Public URL the frontend is served on
FRONTEND_URL=http://46.246.120.148:8980
CORS_ORIGINS=http://46.246.120.148:8980,http://localhost,http://localhost:80,http://127.0.0.1
 
# ── WebRTC (REQUIRED for deployed/cloud servers) ───────────────────────────────
# Public IPv4 of the machine running Docker.
# mediasoup announces this IP in ICE candidates so browsers can reach it.
# If this is wrong or missing the server will refuse to start in production.
MEDIASOUP_ANNOUNCED_IP=46.246.120.148

# ── TURN server (strongly recommended in production) ──────────────────────────
# Without TURN, clients behind symmetric NAT (mobile networks, corporate
# firewalls) cannot send or receive audio/video.
#
# Option A — self-hosted coturn on the same server (cheapest):
#   Install:  sudo apt install coturn
#   Config:   /etc/turnserver.conf  (see docs/coturn-setup.md)
#   Then set:
# TURN_URL=turn:46.246.120.148:3478
# TURN_USERNAME=samtal
# TURN_PASSWORD=change-me-strong-password
#
# Option B — hosted TURN (Twilio / Metered / Xirsys):
#   Get credentials from their dashboard and paste here.
#
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=

# ── Google OAuth ───────────────────────────────────────────────────────────────
GOOGLE_REDIRECT_URI=http://46.246.120.148:8980/auth/google/callback

# ── Frontend build (baked into the SPA at build time) ─────────────────────────
VITE_FRONTEND_URL=http://46.246.120.148:8980
