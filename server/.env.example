NODE_ENV=development
PORT=4001
CORS_ORIGINS=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/meetspace
JWT_SECRET=replace-with-a-secret-at-least-32-chars
FRONTEND_URL=http://localhost:5173
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=49999
MEDIASOUP_LISTEN_IP=0.0.0.0
MEDIASOUP_ANNOUNCED_IP=127.0.0.1
RECORDING_FFMPEG_PATH=ffmpeg
RECORDINGS_DIR=./recordings
STORAGE_DIR=./storage

# Optional Google OAuth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:4001/auth/google/callback

# Optional SMTP (unset = log emails to console)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=Samtal <no-reply@example.com>
