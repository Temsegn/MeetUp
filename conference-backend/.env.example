# =============================================================================
# Mediasoup Conference Engine — Production Environment Template
# =============================================================================
# Copy this file to .env and fill in all required values before deploying.
# NEVER commit .env to version control.
# =============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4001

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Do NOT use * in production.
CORS_ORIGINS=https://meet.yourcompany.com

# ── Database ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/meetspace?retryWrites=true&w=majority

# ── Authentication ────────────────────────────────────────────────────────────
# REQUIRED — must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Global rate limit window (ms). Default: 15 minutes.
RATE_LIMIT_WINDOW_MS=900000
# Max requests per window per IP (global).
RATE_LIMIT_MAX=200
# Max auth requests per window per IP (stricter).
AUTH_RATE_LIMIT_MAX=20

# ── Mediasoup Workers ─────────────────────────────────────────────────────────
# Number of mediasoup worker processes.
# 0 = auto-detect CPU count.
# Recommended: match physical CPU cores (e.g. 4 for a 4-core machine).
MEDIASOUP_WORKERS=4

# UDP/TCP port range for WebRTC media.
# These ports MUST be open in your firewall/security group.
# Each WebRTC transport uses 1 UDP port (with rtcp-mux).
# With 10,000 ports you can support up to 10,000 concurrent transports.
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=49999

# IP address to listen on (usually 0.0.0.0 inside Docker/VM).
MEDIASOUP_LISTEN_IP=0.0.0.0

# Public IP address announced to WebRTC clients via ICE candidates.
# REQUIRED for production — set to your server's public IP.
MEDIASOUP_ANNOUNCED_IP=<your-public-ip>

# ── TURN Server ───────────────────────────────────────────────────────────────
# HIGHLY RECOMMENDED for production.
# Users behind symmetric NAT (corporate networks, mobile) cannot connect without TURN.
# Recommended providers: Twilio TURN, Metered.ca, Xirsys, or self-hosted coturn.
TURN_URL=turns:<your-turn-server>:443?transport=tcp
TURN_USERNAME=
TURN_PASSWORD=

# ── File storage ──────────────────────────────────────────────────────────────
# Root for recordings, photos, and other uploaded files:
#   {STORAGE_DIR}/recordings/{roomId}/{recordingId}/meeting-composite.mp4
#   {STORAGE_DIR}/photos/{userId}/avatar.jpg
#   {STORAGE_DIR}/files/{meetingId}/{filename}
STORAGE_DIR=./storage
# Optional override for recordings only. Default: {STORAGE_DIR}/recordings
# RECORDINGS_DIR=./storage/recordings
# Optional absolute path if ffmpeg is not on PATH
# RECORDING_FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe

# ── Logging ───────────────────────────────────────────────────────────────────
# Options: error | warn | info | debug
LOG_LEVEL=info

# =============================================================================
# DEPLOYMENT CHECKLIST
# =============================================================================
# [ ] JWT_SECRET is set to a strong random value (min 64 hex chars)
# [ ] CORS_ORIGINS contains only your frontend URL(s) — no wildcards
# [ ] MONGODB_URI points to a production replica set
# [ ] MEDIASOUP_ANNOUNCED_IP is set to your server's public IPv4
# [ ] Firewall allows UDP 40000-49999 inbound
# [ ] Firewall allows TCP 4001 inbound (or behind reverse proxy on 443)
# [ ] TURN server is configured and tested
# [ ] FFmpeg installed for server-side recording
# [ ] HTTPS/WSS terminated at reverse proxy (nginx/caddy/ALB)
# [ ] Docker healthcheck points to /health/ready
# [ ] Monitoring set up for /metrics endpoint
# =============================================================================
